{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PocketSubstrate manifest v1",
  "type": "object",
  "required": ["schemaVersion", "apiVersion", "id", "name", "frontend", "backend", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 }, "apiVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,47}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 1000 },
    "frontend": { "const": "web/index.html" }, "backend": { "const": "backend/main.cjs" },
    "capabilities": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "required": ["name", "reason"],
        "properties": {
          "name": { "enum": ["storage", "haptics", "motion", "location", "network"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
          "origins": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^https://[^/?#@]+$" } }
        },
        "if": { "properties": { "name": { "const": "network" } } },
        "then": { "required": ["origins"] }
      }
    }
  },
  "$comment": "Host and publisher additionally enforce unique capability names, exact HTTPS origin parsing, bounded decoded files, and entry-file existence. Unknown top-level metadata is allowed."
}
